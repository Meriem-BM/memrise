# Local API authentication. This is intentionally simple for the initial scaffold.
MEMRISE_API_KEY=local-dev-key
MEMRISE_API_URL=http://localhost:8000

# PostgreSQL
DATABASE_URL=postgresql+psycopg://memrise:memrise@localhost:5432/memrise
POSTGRES_USER=memrise
POSTGRES_PASSWORD=memrise
POSTGRES_DB=memrise

# Qwen / Alibaba Cloud Model Studio. Leave empty to use deterministic local adapters.
ALIBABA_CLOUD_API_KEY=
ALIBABA_CLOUD_BASE_URL=https://dashscope-us.aliyuncs.com/compatible-mode/v1
ALIBABA_CLOUD_WORKSPACE_ID=
ALIBABA_CLOUD_REGION=us-virginia
QWEN_MEMORY_MODEL=qwen-flash
QWEN_EMBEDDING_MODEL=text-embedding-v4
QWEN_EMBEDDING_DIMENSIONS=1024
QWEN_TIMEOUT_SECONDS=30
QWEN_MAX_RETRIES=2

# Runtime knobs
MEMRISE_USE_FAKE_MODEL=true
MEMRISE_WORKER_ID=local-worker-1
MEMRISE_JOB_POLL_SECONDS=1
MEMRISE_REQUEST_MAX_BYTES=1048576
