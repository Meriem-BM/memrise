# API authentication. Auth fails closed: if MEMRISE_API_KEY is unset the server
# rejects every request. Set a strong key here, or set MEMRISE_AUTH_DISABLED=true
# to intentionally run without auth (local dev only).
MEMRISE_API_KEY=local-dev-key
# MEMRISE_AUTH_DISABLED=false
MEMRISE_API_URL=http://localhost:8000
MEMRISE_CORS_ORIGINS=http://localhost:3000

# PostgreSQL
DATABASE_URL=postgresql+psycopg://memrise:memrise@localhost:5432/memrise
POSTGRES_USER=memrise
POSTGRES_PASSWORD=memrise
POSTGRES_DB=memrise

# Qwen / Alibaba Cloud Model Studio. Required for capture, remember, and retrieval.
# Copy this file to .env and set your key; docker compose loads .env for api/worker.
ALIBABA_CLOUD_API_KEY=
# Must match the region where the API key was created (keys are not cross-region).
# Singapore / International: dashscope-intl.aliyuncs.com
# US (Virginia):            dashscope-us.aliyuncs.com
# China (Beijing):          dashscope.aliyuncs.com
ALIBABA_CLOUD_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
ALIBABA_CLOUD_WORKSPACE_ID=
ALIBABA_CLOUD_REGION=ap-southeast-1
QWEN_MEMORY_MODEL=qwen3.6-flash
QWEN_EMBEDDING_MODEL=text-embedding-v4
QWEN_EMBEDDING_DIMENSIONS=1024
QWEN_TIMEOUT_SECONDS=30
QWEN_MAX_RETRIES=2

# Runtime knobs
MEMRISE_WORKER_ID=local-worker-1
MEMRISE_JOB_POLL_SECONDS=1
MEMRISE_REQUEST_MAX_BYTES=1048576
