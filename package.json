{
  "name": "memrise",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=11 <12"
  },
  "scripts": {
    "format": "uv run ruff format . && prettier --write . --ignore-unknown",
    "format:check": "uv run ruff format --check . && prettier --check . --ignore-unknown",
    "lint": "uv run ruff check . && pnpm --recursive lint",
    "typecheck": "uv run pyright && pnpm --filter memrise-memory-sdk build && pnpm --recursive typecheck",
    "test": "pnpm --recursive test",
    "build": "pnpm --recursive build",
    "generate:sdk": "pnpm --filter memrise-memory-sdk generate",
    "check": "make check",
    "hooks:install": "git config core.hooksPath .githooks",
    "hooks:pre-commit": "bash scripts/hooks/pre-commit.sh",
    "hooks:commit-msg": "bash scripts/hooks/commit-msg.sh"
  },
  "devDependencies": {
    "prettier": "3.9.4"
  }
}
